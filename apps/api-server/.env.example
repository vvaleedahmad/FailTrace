# Runtime connection used by the API. Use the Supabase transaction pooler URL.
# Example: postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# CLI/migration connection. Use Supabase's direct/session connection, usually port 5432.
# If omitted, prisma.config.ts derives a best-effort direct URL from DATABASE_URL by switching port 6543 to 5432 and removing pgbouncer=true.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

PORT=4000
NODE_ENV=development

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-local-password"
JWT_SECRET="replace-with-a-long-random-development-secret"
JWT_EXPIRES_IN="1h"

# Redis/BullMQ replay queue. Enable this when running dedicated replay workers.
REDIS_URL="redis://127.0.0.1:6379"
REPLAY_QUEUE_ENABLED=false
REPLAY_WORKER_CONCURRENCY=5
REPLAY_SYNC_CONCURRENCY=5
REPLAY_JOB_ATTEMPTS=3
REPLAY_JOB_BACKOFF_MS=5000
REPLAY_JOB_MAX_STALLED_COUNT=3
REPLAY_JOB_STALLED_INTERVAL_MS=30000
REPLAY_BASE_URL="http://127.0.0.1:4000"
